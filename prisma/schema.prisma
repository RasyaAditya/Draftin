generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum Role {
  GUEST
  CLIENT
  ADMIN
}

enum PricingType {
  FIXED
  CUSTOM_QUOTE
}

enum OrderStatus {
  DRAFT
  WAITING_PAYMENT
  PAID
  IN_PROGRESS
  REVIEW
  REVISION
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CHALLENGE
}

enum InvoiceType {
  DOWN_PAYMENT
  FINAL_PAYMENT
  FULL_PAYMENT
}

enum QuoteRequestStatus {
  SUBMITTED
  REVIEWED
  QUOTED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum RevisionStatus {
  REQUESTED
  IN_PROGRESS
  DELIVERED
  ACCEPTED
}

enum CouponType {
  PERCENTAGE
  NOMINAL
}

enum AttachmentSource {
  CLIENT
  ADMIN
}

enum NotificationChannel {
  EMAIL
  IN_APP
}

// ─────────────────────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         Role      @default(CLIENT)
  isSuspended  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  profile         Profile?
  cart            Cart?
  orders          Order[]
  quoteRequests   QuoteRequest[]
  reviews         Review[]
  messagesSent    Message[]           @relation("MessageSender")
  notifications   Notification[]
  auditLogs       AuditLog[]
  assignedOrders  Order[]             @relation("AssignedArchitect")

  @@map("users")
}

model Profile {
  id        String    @id @default(uuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String?
  address   String?
  city      String?
  avatarUrl String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("profiles")
}

// ─────────────────────────────────────────────────────────────
// Catalog
// ─────────────────────────────────────────────────────────────

model ServiceCategory {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  services Service[]

  @@map("service_categories")
}

model Service {
  id          String    @id @default(uuid())
  categoryId  String
  category    ServiceCategory @relation(fields: [categoryId], references: [id])
  name        String
  slug        String    @unique
  summary     String
  description String
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  packages Servicepackage[]
  images   ServiceImage[]

  @@map("services")
}

model Servicepackage {
  id             String      @id @default(uuid())
  serviceId      String
  service        Service     @relation(fields: [serviceId], references: [id])
  name           String
  slug           String      @unique
  pricingType    PricingType @default(FIXED)
  priceRupiah    BigInt?
  discountRupiah BigInt?
  unit           String? // contoh: "per m2", "per sesi"
  durationDays   Int?
  revisionQuota  Int         @default(0)
  scope          Json // daftar "dapat apa saja"
  isPublished    Boolean     @default(false)
  sortOrder      Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@map("service_packages")
}

model ServiceImage {
  id        String   @id @default(uuid())
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("service_images")
}

// ─────────────────────────────────────────────────────────────
// Cart & Checkout
// ─────────────────────────────────────────────────────────────

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CartItem[]

  @@map("carts")
}

model CartItem {
  id         String        @id @default(uuid())
  cartId     String
  cart       Cart          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  packageId  String
  package    Servicepackage @relation(fields: [packageId], references: [id])
  quantity   Int           @default(1)
  note       String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@map("cart_items")
}

// ─────────────────────────────────────────────────────────────
// Orders
// ─────────────────────────────────────────────────────────────

model Order {
  id                 String      @id @default(uuid())
  orderNumber        String      @unique
  userId             String
  user               User        @relation(fields: [userId], references: [id])
  assignedArchitectId String?
  assignedArchitect  User?       @relation("AssignedArchitect", fields: [assignedArchitectId], references: [id])
  status             OrderStatus @default(DRAFT)
  note               String?
  couponId           String?
  coupon             Coupon?     @relation(fields: [couponId], references: [id])
  subtotalRupiah     BigInt
  discountRupiah     BigInt      @default(0)
  taxRupiah          BigInt      @default(0)
  totalRupiah        BigInt
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  deletedAt          DateTime?

  items       OrderItem[]
  attachments OrderAttachment[]
  timeline    OrderTimeline[]
  revisions   Revision[]
  invoices    Invoice[]
  reviews     Review[]
  messages    Message[]

  @@map("orders")
}

model OrderItem {
  id             String        @id @default(uuid())
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  packageId      String
  package        Servicepackage @relation(fields: [packageId], references: [id])
  packageName    String // snapshot nama paket saat order dibuat
  quantity       Int           @default(1)
  unitPriceRupiah BigInt
  subtotalRupiah  BigInt
  createdAt      DateTime      @default(now())

  @@map("order_items")
}

model OrderAttachment {
  id        String           @id @default(uuid())
  orderId   String
  order     Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  source    AttachmentSource
  fileUrl   String
  fileName  String
  fileType  String
  fileSize  Int
  createdAt DateTime         @default(now())
  deletedAt DateTime?

  @@map("order_attachments")
}

model OrderTimeline {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@map("order_timeline")
}

model Revision {
  id          String         @id @default(uuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedBy String
  status      RevisionStatus @default(REQUESTED)
  note        String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("revisions")
}

// ─────────────────────────────────────────────────────────────
// Billing & Payments
// ─────────────────────────────────────────────────────────────

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type          InvoiceType
  status        InvoiceStatus @default(PENDING)
  amountRupiah  BigInt
  dueAt         DateTime?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  payments Payment[]

  @@map("invoices")
}

model Payment {
  id                String    @id @default(uuid())
  invoiceId         String
  invoice           Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  midtransOrderId   String    @unique
  snapToken         String?
  grossAmountRupiah BigInt
  transactionStatus String?
  fraudStatus       String?
  paymentType       String?
  paidAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  logs PaymentLog[]

  @@map("payments")
}

model PaymentLog {
  id            String   @id @default(uuid())
  paymentId     String
  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  rawPayload    Json
  signatureValid Boolean
  receivedAt    DateTime @default(now())

  @@map("payment_logs")
}

// ─────────────────────────────────────────────────────────────
// Custom Quote
// ─────────────────────────────────────────────────────────────

model QuoteRequest {
  id            String             @id @default(uuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id])
  buildingType  String
  landAreaSqm   Decimal            @db.Decimal(10, 2)
  location      String
  budgetMinRupiah BigInt?
  budgetMaxRupiah BigInt?
  brief         String
  status        QuoteRequestStatus @default(SUBMITTED)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?

  items QuoteItem[]

  @@map("quote_requests")
}

model QuoteItem {
  id             String       @id @default(uuid())
  quoteRequestId String
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  priceRupiah    BigInt
  createdAt      DateTime     @default(now())

  @@map("quote_items")
}

// ─────────────────────────────────────────────────────────────
// Marketing / CMS
// ─────────────────────────────────────────────────────────────

model Coupon {
  id                String     @id @default(uuid())
  code              String     @unique
  type              CouponType
  value             Decimal    @db.Decimal(10, 2)
  minTransactionRupiah BigInt  @default(0)
  quota             Int?
  usedCount         Int        @default(0)
  startsAt          DateTime?
  expiresAt         DateTime?
  isActive          Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  orders Order[]

  @@map("coupons")
}

model Review {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  deletedAt DateTime?

  @@map("reviews")
}

model Portfolio {
  id            String    @id @default(uuid())
  title         String
  slug          String    @unique
  category      String
  coverImageUrl String
  beforeImageUrl String?
  afterImageUrl  String?
  summary       String
  content       String
  isPublished   Boolean   @default(false)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@map("portfolios")
}

// ─────────────────────────────────────────────────────────────
// Communication
// ─────────────────────────────────────────────────────────────

model Message {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation("MessageSender", fields: [senderId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@map("messages")
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime            @default(now())

  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────
// System
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}
